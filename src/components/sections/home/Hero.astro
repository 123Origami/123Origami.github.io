---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import sally from "../../../assets/images/sally-hero.svg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">Hey there! I'm a Computer Science graduate who builds secure, scalable software — from full-stack web apps to cloud infrastructure and cybersecurity solutions.</Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <Link variant={'button'} href="/contact">Get in Touch</Link>
            <Heading tagName="h1" tagSize="h1">Sally Munga</Heading>
        </Container>
        <Container class="h-full md:h-[500px] flex-1">
            <ImageContainer src={sally} alt="Sally Munga" />
        </Container>
    </Container>
</Container>


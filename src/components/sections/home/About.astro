---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import sallyAbout from "../../../assets/images/sally-photo.jpg";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">
            <Text variant={'xl'}>I'm a problem-solver who thrives at the intersection of code, security, and systems.</Text>
            <Text variant={'sm'}>I build full-stack applications with Python, Django, and SQL, and I'm expanding into cloud infrastructure and cybersecurity — recently certified in ethical hacking, and cloud and network security.</Text>
            <Text variant={'sm'}>When I'm not coding, you'll find me exploring new certifications, contributing to my university's AWS Student Builder Group, or working through a CTF challenge. I believe the best software comes from understanding both the people who use it and the systems that could break it.</Text>
            <Link variant={'button'} href="/about">More about me</Link>
        </div>
        <div class="w-full lg:h-[500px] h-auto lg:flex-1">
            <ImageContainer src={sallyAbout} alt="Sally Munga" />
        </div>
    </div>
</Container>
---
// components
import Heading from "../../elements/Heading.astro";
import Container from "../../elements/Container.astro";
import Text from "../../elements/Text.astro";
---

<Container variant={'xl'} class="text-center text-base-900 flex flex-col items-center">
    <Heading tagName="h1" tagSize="h1">Contact</Heading>
    <div class="max-w-3xl flex flex-col gap-4">
        <Text variant={'xl'}>Let's Build Something Great Together!</Text>
        <Text variant={'sm'}>Looking for a software developer for an internship, full-time role, or collaborative project? I'd love to hear about it and explore how I can help bring it to life.</Text>
        <Text variant={'sm'}>Currently open to new opportunities. Response time: 24-48 hours.</Text>
    </div>
</Container>